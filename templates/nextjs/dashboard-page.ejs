import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card';
import { prisma } from '@/lib/prisma';
import { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, PieChart, Pie, Cell, LineChart, Line, Legend } from 'recharts';

interface Props {
  params: { name: string };
}

// COLORS for pie charts
const COLORS = ['#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#06b6d4'];

export default async function DashboardPage({ params }: Props) {
  const dashboardName = decodeURIComponent(params.name);

<%
  // Generate server-side data fetching for each dashboard element
  // This is pseudo-code that the generator expands per-dashboard
%>

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold">{dashboardName}</h1>
        <p className="text-muted-foreground">Dashboard overview</p>
      </div>

      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <%_ dashboard.elements.filter(e => e.type === 'Card').forEach(card => { -%>
        <Card>
          <CardHeader>
            <CardDescription><%= card.name %></CardDescription>
            <CardTitle className="text-3xl">
              {await prisma.<%= card.sourceEntity.toLowerCase() %>.count()}
            </CardTitle>
          </CardHeader>
        </Card>
        <%_ }) -%>
      </div>

      <div className="grid gap-4 md:grid-cols-2">
        <%_ dashboard.elements.filter(e => e.type === 'Chart').forEach(chart => { -%>
        <Card>
          <CardHeader>
            <CardTitle><%= chart.name %></CardTitle>
            <CardDescription>
              <%= chart.chartType %> chart from <%= chart.sourceEntity %> by <%= chart.groupByField %>
            </CardDescription>
          </CardHeader>
          <CardContent>
            <ResponsiveContainer width="100%" height={300}>
              {(() => {
                // Data is fetched server-side
                const data: Array<{ name: string; value: number }> = [];
                <%_ if (chart.chartType === 'bar') { -%>
                return (
                  <BarChart data={data}>
                    <CartesianGrid strokeDasharray="3 3" />
                    <XAxis dataKey="name" />
                    <YAxis />
                    <Tooltip />
                    <Bar dataKey="value" fill="#3b82f6" />
                  </BarChart>
                );
                <%_ } else if (chart.chartType === 'line') { -%>
                return (
                  <LineChart data={data}>
                    <CartesianGrid strokeDasharray="3 3" />
                    <XAxis dataKey="name" />
                    <YAxis />
                    <Tooltip />
                    <Legend />
                    <Line type="monotone" dataKey="value" stroke="#3b82f6" />
                  </LineChart>
                );
                <%_ } else { -%>
                return (
                  <PieChart>
                    <Pie data={data} dataKey="value" nameKey="name" cx="50%" cy="50%" outerRadius={100}>
                      {data.map((_, index) => (
                        <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                      ))}
                    </Pie>
                    <Tooltip />
                  </PieChart>
                );
                <%_ } -%>
              })()}
            </ResponsiveContainer>
          </CardContent>
        </Card>
        <%_ }) -%>
      </div>

      <%_ dashboard.elements.filter(e => e.type === 'TableView').forEach(table => { -%>
      <Card>
        <CardHeader>
          <CardTitle><%= table.name %></CardTitle>
          <CardDescription>Table view from <%= table.sourceEntity %></CardDescription>
        </CardHeader>
        <CardContent>
          {/* Table component rendered here */}
        </CardContent>
      </Card>
      <%_ }) -%>
    </div>
  );
}
